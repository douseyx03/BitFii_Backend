# Copier ce fichier en .env puis remplir les valeurs de VOTRE réseau Polar.
# Ne jamais partager ni committer le .env : les macaroons donnent le contrôle total des nœuds.
# Pas à pas: voir GUIDELINE.md

# --- Serveur ---
PORT=5003

# Origine du frontend React autorisée par CORS (vide = toutes, à éviter).
CORS_ORIGIN=http://localhost:5173

# Optionnel: exige l'en-tête `x-api-key: <valeur>` sur /api (vide = pas d'auth, dev local).
# API_KEY=change-me

# --- Nœud 1: boutique (reçoit les paiements) ---
# Polar > nœud boutique > onglet Connect > GRPC Host, TLS Cert et Admin Macaroon au format Base64
LND_NODE_ID_1=boutique
LND_GRPC_HOST_1=127.0.0.1:10001
LND_MACAROON_BASE64_1=<admin.macaroon du nœud boutique en base64>
LND_TLS_CERT_BASE64_1=<tls.cert du nœud boutique en base64>

# --- Nœud 2: client (paie les factures) ---
LND_NODE_ID_2=client
LND_GRPC_HOST_2=127.0.0.1:10002
LND_MACAROON_BASE64_2=<admin.macaroon du nœud client en base64>
LND_TLS_CERT_BASE64_2=<tls.cert du nœud client en base64>

# --- Règles Bitfii ---
# Taux fixe pour convertir les montants FCFA en sats (1 BTC = N FCFA). A ajuster.
FCFA_PER_BTC=60000000

# Plafond par facture, en sats.
MAX_INVOICE_SATS=1000000

# Rôles: seuls ces nœuds peuvent créer des factures / payer. Vide = tous autorisés.
INVOICE_NODES=boutique
PAY_NODES=client
